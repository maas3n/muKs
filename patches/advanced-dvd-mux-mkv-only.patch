+// advancedMuxFormatOptions limits DVD-containing selections to MKV in the
+// ADVANCED UI. No muxing or stream-processing behavior is changed.
+func advancedMuxFormatOptions(chosen []mergerStream) ([]string, bool) {
+	options := []string{"MKV — all selected streams and chapters", "M2TS — video/audio/PGS; no chapters"}
+	for _, stream := range chosen {
+		if stream.Track.DVDTitle > 0 {
+			return options[:1], true
+		}
+	}
+	return options, false
+}
