--- a/src/advanced_mux_format_linux_test.go
+++ b/src/advanced_mux_format_linux_test.go
@@ -0,0 +1,42 @@
+//go:build linux && !cli
+
+package main
+
+import "testing"
+
+func TestAdvancedMuxFormatOptionsDVDOnly(t *testing.T) {
+	formats, dvd := advancedMuxFormatOptions([]mergerStream{
+		{Track: trackOption{DVDTitle: 1, Kind: "video"}},
+		{Track: trackOption{DVDTitle: 1, Kind: "audio"}},
+	})
+	if !dvd || len(formats) != 1 || formats[0] != "MKV — all selected streams and chapters" {
+		t.Fatalf("DVD should offer only MKV; dvd=%v formats=%v", dvd, formats)
+	}
+}
+
+func TestAdvancedMuxFormatOptionsMixedWithDVD(t *testing.T) {
+	formats, dvd := advancedMuxFormatOptions([]mergerStream{
+		{BluRay: true, Track: trackOption{Kind: "video"}},
+		{Track: trackOption{DVDTitle: 3, Kind: "audio"}},
+	})
+	if !dvd || len(formats) != 1 {
+		t.Fatalf("mixed selection with DVD should offer only MKV; dvd=%v formats=%v", dvd, formats)
+	}
+}
+
+func TestAdvancedMuxFormatOptionsWithoutDVD(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		streams []mergerStream
+	}{
+		{"Blu-ray", []mergerStream{{BluRay: true, Track: trackOption{Kind: "video"}}}},
+		{"regular file", []mergerStream{{Track: trackOption{Kind: "video"}}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			formats, dvd := advancedMuxFormatOptions(tc.streams)
+			if dvd || len(formats) != 2 {
+				t.Fatalf("non-DVD selection should retain MKV and M2TS; dvd=%v formats=%v", dvd, formats)
+			}
+		})
+	}
+}
